rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Isolated user storage: allows users full access to their user profiles and subcollections
    match /users/{userId} {
      allow read, write: if true;
      
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }
  }
}
