rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Isolated user data space: accessible by any authenticated session
    match /users/{userId} {
      allow read, write: if request.auth != null;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
